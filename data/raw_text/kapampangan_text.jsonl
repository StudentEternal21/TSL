{"id": "kap_632", "text": "Pamu saguli."}
{"id": "kap_633", "text": "Pamu o!"}
{"id": "kap_634", "text": "Pamu nokarin?"}
{"id": "kap_635", "text": "Pamu ayan na."}
{"id": "kap_636", "text": "Pamu pu!"}
{"id": "kap_637", "text": "Misabi katapamu."}
{"id": "kap_638", "text": "Masalese pamung lapitan daka?"}
{"id": "kap_639", "text": "Pamu, sabian mepamu."}
{"id": "kap_640", "text": "Sasadya kupamu."}
{"id": "kap_641", "text": "Gawan kupamu."}
{"id": "kap_642", "text": "Dakitan kepamu i Paula karela."}
{"id": "kap_643", "text": "Kamagnipiku mung tao!"}
{"id": "kap_644", "text": "Magnipukung pelagen."}
{"id": "kap_645", "text": "Magnipikung alang kalupa."}
{"id": "kap_646", "text": "Magnipiku ku kasi."}
{"id": "kap_647", "text": "Nung naman agawa e gawan mune."}
{"id": "kap_648", "text": "Nung naman panusignan me emanyilbi."}
{"id": "kap_649", "text": "Lalagen naku ning maglalage."}
{"id": "kap_650", "text": "Lalagen naka ning konsensia."}
{"id": "kap_651", "text": "Emagpigaganakanananganananganan."}
{"id": "kap_652", "text": "Apipigaganakanananganananganan."}
{"id": "kap_653", "text": "Mapapangalinguanananganananganan."}
{"id": "kap_654", "text": "Mababalisanananganananganan ka?"}
{"id": "kap_655", "text": "Akakapangalinguanananganananganan mu."}
{"id": "kap_656", "text": "Makapangabayatanananganananganan."}
{"id": "kap_657", "text": "Turuanan daka."}
{"id": "kap_658", "text": "Sabitanang medalya king dalig."}
{"id": "kap_659", "text": "Sintanang igulisak."}
{"id": "kap_660", "text": "Silatanan nakang José."}
{"id": "kap_661", "text": "Likuanan ke."}
{"id": "kap_662", "text": "Marayu naneng akuwa ita."}
{"id": "kap_663", "text": "Malaut neng abutan ta."}
{"id": "kap_664", "text": "Emalyaring gawan me yan."}
{"id": "kap_665", "text": "Emalyari kanaku."}
{"id": "kap_666", "text": "Simap mipakeni ka?"}
{"id": "kap_667", "text": "Simap naman atiyu naka."}
{"id": "kap_668", "text": "Simap? Nanung atin?"}
{"id": "kap_669", "text": "Simap alayo!"}
{"id": "kap_670", "text": "Palimparan dareng lobu."}
{"id": "kap_671", "text": "Palimparan dareng ayup"}
{"id": "kap_672", "text": "Palimparan ing pipamanugsen a pepalimparang depapil."}
{"id": "kap_673", "text": "Palimparan yang burarul ing babo-banwa."}
{"id": "kap_674", "text": "Iyang pekamalagu kareng eganagana."}
{"id": "kap_675", "text": "Maluat pa bayu ku mate."}
{"id": "kap_676", "text": "Maluat na anyang mikit kata."}
{"id": "kap_677", "text": "Manumpisang pagtaka."}
{"id": "kap_678", "text": "Magpapiestang pagtaka."}
{"id": "kap_679", "text": "Kasal ne anya alanang pagtaka."}
{"id": "kap_680", "text": "Anya pala pagtaka nung bakit makanita ya?"}
{"id": "kap_681", "text": "Numbaga itugma me."}
{"id": "kap_682", "text": "Numbaga alayu."}
{"id": "kap_683", "text": "Buri kung mangan numbaga alakung apangan."}
{"id": "kap_684", "text": "Migpapaururan ku numbaga makamal naman."}
{"id": "kap_685", "text": "Buri keng pakisabian numbaga alayu."}
{"id": "kap_686", "text": "Dapat makanini de. Numbaga masanting yang lalawen."}
{"id": "kap_687", "text": "Paburen mune. Numbaga. Alimune papansinan pa."}
{"id": "kap_688", "text": "Puntalan muku kapilanman mu buri."}
{"id": "kap_689", "text": "Puntalan mukung kapilanka."}
{"id": "kap_690", "text": "Aling-alidaka aburian ne."}
{"id": "kap_691", "text": "Tabalu bakit kaya."}
{"id": "kap_692", "text": "Bakit kaya pakanita?"}
{"id": "kap_693", "text": "Magtaka kumu nung bakit kaya."}
{"id": "kap_694", "text": "Makasara bakit kaya."}
